generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  REGIONAL_ADMIN
  BRANCH_MANAGER
  COURIER
  CUSTOMER
}

model User {
  id            String   @id @default(cuid())
  phone         String?  @unique
  name          String?
  email         String?  @unique
  googleId      String?  @unique
  passwordHash  String?
  role          Role     @default(CUSTOMER)
  regionId      String?
  branchId      String?
  telegramId    String?  @unique
  isActive      Boolean  @default(true)
  phoneVerified Boolean  @default(false)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  region        Region?        @relation(fields: [regionId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]

  @@index([phone])
  @@index([email])
  @@index([googleId])
  @@index([regionId])
  @@map("users")
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  users     User[]
  branches  Branch[]

  @@map("regions")
}

model Branch {
  id        String   @id @default(cuid())
  regionId  String
  name      String
  address   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  region Region @relation(fields: [regionId], references: [id])
  users  User[]

  @@index([regionId])
  @@map("branches")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String   @default("login")
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  family    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}
