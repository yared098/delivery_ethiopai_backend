# Host port exposed by Docker Compose
PORT=3000

# Use a hex-only password so it can safely be embedded in DATABASE_URL.
POSTGRES_DB=deliver
POSTGRES_USER=deliver
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql://deliver:<POSTGRES_PASSWORD>@localhost:5433/deliver?schema=public
REDIS_URL=redis://localhost:6380

# Generate each secret separately with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret
QR_SECRET=replace-with-a-unique-random-secret
TRACKING_SECRET=replace-with-a-different-unique-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_10MIN=3

# Required at startup: configure all three Firebase values.
# Keep private key newlines escaped as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set these to the public URLs for your production deployment.
APP_URL=https://api.example.com
BACKEND_URL=https://api.example.com
PUBLIC_WEB_URL=https://example.com
FRONTEND_URL=https://example.com

# Optional external integrations
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=DELIVER
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used only when running the Super Admin seed command
SUPER_ADMIN_PHONE=0911111111
SUPER_ADMIN_NAME=Super Admin
